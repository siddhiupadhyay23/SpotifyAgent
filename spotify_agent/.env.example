# Copy this file to .env and fill in your key
# The system works WITHOUT an API key using a template fallback.
# Set this key to enable LLM-powered generation and the LLM judge.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Required for the local support-admin login. Set a unique local password;
# this file deliberately contains no working credential.
SPOTIFY_AGENT_ADMIN_EMAIL=admin@spotifyagent.local
SPOTIFY_AGENT_ADMIN_PASSWORD=replace-with-a-unique-local-demo-password
